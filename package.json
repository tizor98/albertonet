{
    "name": "albertonet-new",
    "type": "module",
    "version": "2.0.0",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
